# NovariPartners API Server — Required Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Site URL (used for Nexi redirect URLs) ───────────────────────────────────
SITE_URL=https://novaripartners.com

# ── CORS (comma-separated list of allowed origins) ──────────────────────────
ALLOWED_ORIGINS=https://novaripartners.com,https://www.novaripartners.com

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/novaridb

# ── Admin Panel ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_JWT_SECRET=replace_with_64_char_random_hex  # openssl rand -hex 32

# ── Nexi XPay ───────────────────────────────────────────────────────────────
NEXI_ENV=production       # sandbox | production
NEXI_API_KEY=             # From Nexi XPay dashboard

# ── Optional ────────────────────────────────────────────────────────────────
EUR_USD_RATE=1.09         # Fallback EUR/USD conversion rate
